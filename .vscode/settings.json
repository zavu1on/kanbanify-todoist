{
  "search.exclude": {
    "**/.yarn": true,
    "**/.pnp.*": true
  },
  "js/ts.tsdk.path": ".yarn/sdks/typescript/lib",
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.spec.ts, ${capture}.test.ts, ${capture}.spec.tsx, ${capture}.test.tsx",
    "*.tsx": "${capture}.spec.tsx, ${capture}.test.tsx"
  }
}
